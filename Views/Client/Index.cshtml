@model List<FreelanceHub.Models.Client>

@if (TempData["Success"] != null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Dashboard</h5>
            <p class="card-text">
                Total Clients: <strong>@ViewBag.TotalClients</strong>
            </p>
        </div>
    </div>

    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Index" method="get" class="row mb-3">

    <div class="col-md-6">
        <input type="text"
               name="search"
               class="form-control"
               placeholder="Search by Name, Email or Company"
               value="@Context.Request.Query["search"]" />
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">
            Search
        </button>
    </div>

    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-secondary w-100">
            Reset
        </a>
    </div>

    <div class="col-md-2">
        <a asp-action="Create" class="btn btn-success w-100">
            + Add Client
        </a>
    </div>

</form>

@if (Model.Any())
{
    <h2>Clients</h2>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Company</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var client in Model)
            {
                <tr>
                    <td>@client.Id</td>
                    <td>@client.Name</td>
                    <td>@client.Email</td>
                    <td>@client.CompanyName</td>
                    <td>
                        <div class="d-flex gap-2">

                            <a asp-action="Details"
                               asp-route-id="@client.Id"
                               class="btn btn-sm btn-info">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@client.Id"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@client.Id"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning mt-3">
        <strong>No clients found.</strong>
        Try a different search term.
    </div>
}