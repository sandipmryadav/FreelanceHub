@model List<FreelanceHub.Models.Client>

<form asp-action="Index" method="get" class="row mb-3">

    <div class="col-md-6">
        <input type="text"
               name="search"
               class="form-control"
               placeholder="Search by Name, Email or Company"
               value="@Context.Request.Query["search"]" />
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">
            Search
        </button>
    </div>

    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-secondary w-100">
            Reset
        </a>
    </div>

</form>

    <h2>Clients</h2>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Company</th>
                <th>Actions</th>
            </tr>
        </thead>
             
        <tbody>
        @foreach(var client in Model)
        {
            <tr>
                <td>@client.Id</td>
                <td>@client.Name</td>
                <td>@client.Email</td>
                <td>@client.CompanyName</td>
               <td>
                   <div class="d-flex gap-2">
                       <a asp-controller="Client" asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-primary">Edit</a>
                       <a asp-controller="Client" asp-action="Delete" asp-route-id="@client.Id" class="btn btn-sm btn-danger">Delete</a>
                       <a asp-controller="Client" asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-info">Details</a>
                   </div>
               </td>
            </tr>
        }
        </tbody>
    </table>