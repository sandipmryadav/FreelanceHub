@model List<FreelanceHub.Models.Client>

    <h2>Clients</h2>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Company</th>
                <th>Actions</th>
            </tr>
        </thead>
             
        <tbody>
        @foreach(var client in Model)
        {
            <tr>
                <td>@client.Id</td>
                <td>@client.Name</td>
                <td>@client.Email</td>
                <td>@client.CompanyName</td>
               <td>
                   <div class="d-flex gap-2">
                       <a asp-controller="Client" asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-primary">Edit</a>
                       <a asp-controller="Client" asp-action="Delete" asp-route-id="@client.Id" class="btn btn-sm btn-danger">Delete</a>
                   </div>
               </td>
            </tr>
        }
        </tbody>
    </table>