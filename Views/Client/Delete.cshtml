@model FreelanceHub.Models.Client


<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-danger text-white">
            <h3>Delete Client</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <strong>Warning!</strong> Are you sure you want to delete this client?
            </div>

            <dl class="row">

                <dt class="col-sm-3">
                    Name
                </dt>

                <dd class="col-sm-9">
                    @Model.Name
                </dd>

                <dt class="col-sm-3">
                    Email
                </dt>

                <dd class="col-sm-9">
                    @Model.Email
                </dd>

                <dt class="col-sm-3">
                    Company
                </dt>

                <dd class="col-sm-9">
                    @Model.CompanyName
                </dd>

            </dl>

            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>